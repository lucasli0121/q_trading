# ============================================================
# stock.cfg 配置模板（Web 端）
#
# 用法：
#   1) 复制为本目录下的 stock.cfg
#        Windows:  copy cfg\stock.cfg.example cfg\stock.cfg
#        Linux  :  cp cfg/stock.cfg.example cfg/stock.cfg
#   2) 按注释逐项填写。模板内所有值一律留空；未填写的必填项
#      会在启动阶段明确报错。这是刻意设计——避免未配置时
#      静默连到错误的环境。
#   3) 真实 stock.cfg 已被 .gitignore 忽略，不会进入版本库。
# ============================================================


[server]
# 服务端地址（域名或 IP）
host=
# 服务端端口
port=
# 服务端管理令牌，需与服务端一致
admin_token=

[mqtt]
# Broker 主机（域名或 IP）
host=
# 端口，TLS 常用 8883，明文常用 1883
port=
# 客户端 ID，同一 Broker 上需唯一
client_id=
# 用户名
username=
# 口令
password=
# 是否启用 TLS：true / false
need_tls=
# TLS 客户端证书、私钥、CA 文件路径（need_tls=true 时需要）
cert_file=
key_file=
ca_file=

[web]
# 监听地址，如 0.0.0.0
listen_host=
# 监听端口
listen_port=
# 会话存储签名密钥（NiceGUI storage_secret）。
# 不配置则每次启动随机生成：更安全，但进程重启后所有会话失效、用户需重新登录。
# 生产环境请显式配置一个足够随机的值（例如 openssl rand -hex 32 的输出）。
# 也可用环境变量 Q_TRADING_STORAGE_SECRET 覆盖本项。
storage_secret=

[log]
# 日志配置文件路径
config=

[strategy]
# 页面展示的策略类型，逗号分隔
type=
