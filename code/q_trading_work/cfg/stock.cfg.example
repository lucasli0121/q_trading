# ============================================================
# stock.cfg 配置模板（策略引擎）
#
# 用法：
#   1) 复制为本目录下的 stock.cfg
#        Windows:  copy cfg\stock.cfg.example cfg\stock.cfg
#        Linux  :  cp cfg/stock.cfg.example cfg/stock.cfg
#   2) 按注释逐项填写。模板内所有值一律留空；未填写的必填项
#      会在启动阶段明确报错。这是刻意设计——避免未配置时
#      静默连到错误的环境。
#   3) 真实 stock.cfg 已被 .gitignore 忽略，不会进入版本库。
# ============================================================


[server]
# 服务端地址（域名或 IP）
host=
# 服务端端口
port=
# 服务端管理令牌，需与服务端一致
admin_token=

[mqtt]
# Broker 主机（域名或 IP）
host=
# 端口，TLS 常用 8883，明文常用 1883
port=
# 客户端 ID，同一 Broker 上需唯一
client_id=
# 用户名
username=
# 口令
password=
# 心跳间隔（秒）
keep_alive=
# 是否启用 TLS：true / false
need_tls=
# TLS 客户端证书、私钥、CA 文件路径（need_tls=true 时需要）
cert_file=
key_file=
ca_file=

[log]
# 日志配置文件路径
config=

[scheduler]
# 盘前任务执行时刻（24 小时制）
before_trading_hour=
before_trading_minute=
# 盘后阀门计算执行时刻（当日信号 + 分钟行情 → 次日门槛偏移）
after_trading_hour=
after_trading_minute=

[market_breadth]
# 前一交易日跌停家数 → 全局买卖门槛偏移的分档，
# 格式「上界:偏移」逗号分隔，上界需升序；超出最后一档的按最后一档取值。
# 买入门槛上调该偏移；卖出侧取负号，另有独立上限。
bands=
# 卖出侧放宽幅度上限（绝对值）。买入侧最大 3.0，卖出侧取一半不到，
# 避免市场偏移把卖出条件放宽成「见正分就抛」。0 表示不设上限。
max_sell_offset=
# 极端利空禁买：前一交易日跌停家数超过该值，且该股盘后阀门达到最高档
# （当日买入侧跌破 S3）时，该股当日只卖不买。两个条件需同时成立。
# 取不到跌停家数时不触发，避免一次接口抖动停掉整个实例的买入。
# 设为 0 或负数表示关闭该联动，只保留上面的门槛偏移。
stop_buy_limit_down=

[trade]
# 企业微信机器人 webhook 地址，留空则不推送
enterprise_wechat_webhook_url=
# 微信通知 webhook 地址，留空则不推送
wechat_webhook_url=
# 微信通知接收人，留空则不指定
wechat_friend_name=

[strategy]
# 启用的策略类型，逗号分隔
type=

[signal_filter]
# 信号风暴过滤：连续相同方向信号需同时满足以下条件才发出新信号
# 价格变化阈值（%）：超过此阈值才发出
price_change_threshold=
# 时间间隔阈值（分钟）：超过此间隔才发出
time_gap_minutes=
# 成交间隔限制：不分方向，距上一条交易信号不足此间隔（分钟）即抑制，
# 0 表示关闭。与上面的风暴过滤是两件事——那条只比较同方向连续信号，
# 压不住「卖完又买回」这类跨方向的高频进出。跨日不判。
# 与回测参数 --min-trade-interval-minutes 语义一致。
min_trade_interval_minutes=

[cost_config]
# 买入滑点（元）：成交价 = 当前价 + buy_slip
buy_slip=
# 卖出滑点（元）：成交价 = 当前价 - sell_slip
sell_slip=
# 手续费百分率（%），如 0.02 表示 0.02%
fee_pct=
# 最低手续费（元），按比例计算不足时按此收取
fee_low=

[workflow]
# 工作流服务名，同一部署内需唯一
service_name=
# 是否派发实时 tick 行情任务：true / false
enable_handle_tick=
# 行情派发队列上限（背压）：队列满时丢弃最旧的待处理行情
order_queue_size=

[benchmark]
# 基准标的代码，用于计算 benchmark_return_rate。
# 留空 = 关闭基准计算。
code=

[redis]
# 是否启用 Redis：true / false
enable=
# 主机（域名或 IP）
host=
# 端口
port=
# 访问口令
password=
# 库号，常用 0
db=
# 是否启用 TLS：true / false
enable_ssl=
# TLS 客户端证书、私钥、CA 文件路径（enable_ssl=true 时需要）
cert=
key=
ca=
