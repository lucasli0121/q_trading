# ============================================================
# cfg.yml 配置模板（rhserver）
#
# 用法：
#   1) 复制为本目录下的 cfg.yml
#        Windows:  copy cfg\cfg.yml.example cfg\cfg.yml
#        Linux  :  cp cfg/cfg.yml.example cfg/cfg.yml
#   2) 按注释逐项填写。模板内所有值一律留空；未填写的必填项
#      会在启动阶段明确报错。这是刻意设计——避免未配置时
#      静默连到错误的环境。
#   3) 真实 cfg.yml 已被 .gitignore 忽略，不会进入版本库。
#   4) 证书/私钥（*.crt、*.key）同样被 .gitignore 排除，不会提交。
# ============================================================
server:
  # 监听地址:端口
  host:
  # 对外访问 URL，证书域名需与之一致
  out_url:
  # 服务端证书、私钥、CA 路径
  certFile:
  keyFile:
  caFile:
database:
  # 数据库连接串。MySQL 形如 tcp(host:port)；Mongo 形如 mongodb://host:port
  url:
  # 认证用户名
  username:
  # 认证口令
  password:
  # 数据库名
  dbname:
  # 驱动类型：mysql / mongo
  driver:
redis:
  # 主机:端口
  host:
  # 访问口令
  password:
  # 库号，常用 0
  db:
  # 证书、私钥、CA 路径
  certFile:
  keyFile:
  caFile:
mq:
  # Broker 主机
  host:
  # 端口，TLS 常用 8883，明文常用 1883
  port:
  # 客户端 ID，同一 Broker 上需唯一
  client_id:
  # 用户名
  username:
  # 口令
  password:
  # 证书、私钥、CA 路径
  certFile:
  keyFile:
  caFile:
log:
  # 日志级别：debug / info / warn / error
  level:
  # 日志文件路径
  file:
  # 单个日志文件大小上限（MB）
  maxsize:
  # 日志保留天数
  maxage:
  # 保留的旧日志文件个数
  maxbackups:
  # 是否同时输出到控制台：true / false
  console:
  # 日志格式：text / json
  format:

# 静态文件目录
staticPath:
