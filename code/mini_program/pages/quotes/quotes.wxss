/* 搜索图标 */
.search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid var(--color-text-tertiary);
  border-radius: 50%;
  position: relative;
  flex: none;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 12rpx;
  height: 3rpx;
  background-color: var(--color-text-tertiary);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-cancel {
  font-size: var(--metric-font-size-sm);
  color: var(--color-brand-link);
  padding: 8rpx 0 8rpx 8rpx;
  flex: none;
}

/* 统计栏 */
.pool-stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: var(--metric-space-lg) 0;
  padding: var(--metric-space-md) 0;
  background-color: var(--color-bg-surface);
  border: 1rpx solid var(--color-border-default);
  border-radius: var(--metric-radius-lg);
}

.pool-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.pool-stat + .pool-stat {
  border-left: 1rpx solid var(--color-border-divider);
}

.pool-stat-v {
  font-size: var(--metric-font-size-2xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.pool-stat-k {
  font-size: var(--metric-font-size-xs);
  color: var(--color-text-secondary);
}

/* 卡片 */
.pool-list {
  display: flex;
  flex-direction: column;
  gap: var(--metric-space-md);
}

.pool-card {
  padding: var(--metric-space-lg);
}

.pool-card--hover {
  opacity: 0.92;
}

.pool-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.pool-type {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: var(--metric-radius-tag);
  background-color: var(--color-bg-subtle);
}

.pool-type-icon {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.pool-type-text {
  font-size: var(--metric-font-size-2xs);
  color: var(--color-text-secondary);
  font-weight: 600;
}

.pool-name {
  font-size: var(--metric-font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.pool-desc {
  margin-top: 8rpx;
  font-size: var(--metric-font-size-sm);
  color: var(--color-text-tertiary);
  line-height: 1.6;
  min-height: 44rpx;
}

.pool-ft {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--metric-space-md);
  padding-top: var(--metric-space-md);
  border-top: 1rpx solid var(--color-border-divider);
}

.pool-count {
  font-size: var(--metric-font-size-md);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.pool-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--metric-space-sm);
}

/* 虚线占位卡 */
.pool-create {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 180rpx;
  border: 2rpx dashed var(--color-border-control);
  border-radius: var(--metric-radius-lg);
}

.pool-create-plus {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-text-tertiary);
}

.pool-create-text {
  font-size: var(--metric-font-size-md);
  color: var(--color-text-secondary);
}
