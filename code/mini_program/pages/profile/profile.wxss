/* Tab4 · 我的 */

.user-card { margin-bottom: var(--metric-space-md); }

.avatar {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 50%;
  background-color: var(--color-brand-primary);
  color: var(--color-text-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.user-stats {
  margin-top: var(--metric-space-lg);
  padding-top: var(--metric-space-md);
  border-top: var(--metric-border-width) solid var(--color-border-divider);
  align-items: stretch !important;
}

.us-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.us-v {
  font-size: var(--metric-font-size-xl);
  font-weight: 700;
}

.us-k {
  font-size: var(--metric-font-size-xs);
  color: var(--color-text-tertiary);
}

.us-div {
  width: 1rpx;
  background-color: var(--color-border-divider);
}

.card + .card { margin-top: var(--metric-space-md); }

.entry-icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  margin-right: var(--metric-space-md);
  border-radius: var(--metric-radius-md);
  background-color: var(--color-bg-subtle);
  color: var(--color-brand-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.entry-arrow {
  margin-left: var(--metric-space-sm);
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.risk-note {
  margin-top: var(--metric-space-lg);
  text-align: center;
  font-size: var(--metric-font-size-xs);
  color: var(--color-text-tertiary);
}
