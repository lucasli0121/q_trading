# 构建时配置（复制为同目录下的 .env.local 后填写）
#
#   Windows:  copy config\.env.local.example config\.env.local
#   Linux  :  cp config/.env.local.example config/.env.local
#
# .env.local 已被 .gitignore 排除，不会进入版本库。
# 改完执行：node tools/gen-config.js  （生成 config/index.js）

# 环境名：development / production
# 设为 production 时，脚本会强制校验 BASE_URL 为 https、WS_URL 为 wss
MP_ENV=development

# 后端 FastAPI 服务地址，不带结尾斜杠
# 留空则使用缺省值 http://127.0.0.1:8000
MP_BASE_URL=

# 交易信号 WebSocket 地址
# 留空 = 关闭 WS（自动降级为 HTTP 轮询）；不填该行 = 由 MP_BASE_URL 自动推导
MP_WS_URL=

# 小程序 appId，留空则沿用 project.config.json 中的值
MP_WX_APPID=
