/* 顶部导航 —— 高度 56pt(112rpx)，标题居中，两侧热区 44×44pt */

.navbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 700;
  background-color: var(--color-bg-elevated);
  border-bottom: 1rpx solid var(--color-border-default);
}

.navbar-bar {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding: 0 8rpx;
}

.navbar-side {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 88rpx;
  gap: 4rpx;
}

.navbar-side--left {
  justify-content: flex-start;
}

.navbar-side--right {
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
}

.navbar-title {
  position: absolute;
  left: 176rpx;
  right: 176rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  pointer-events: none;
}

/* 44×44pt 最小热区 */
.navbar-hit {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.navbar-hit--hover {
  opacity: 0.7;
}

.navbar-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--color-text-primary);
  border-bottom: 4rpx solid var(--color-text-primary);
  transform: rotate(45deg);
  margin-left: 6rpx;
  border-radius: 2rpx;
}

/* 刷新图标（纯 CSS） */
.navbar-refresh {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--color-text-secondary);
  border-radius: 50%;
  border-right-color: transparent;
  border-top-color: transparent;
  position: relative;
}

.navbar-refresh::after {
  content: '';
  position: absolute;
  right: -2rpx;
  top: 2rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 10rpx solid var(--color-text-secondary);
  transform: rotate(45deg);
}

/* 右侧文字操作（小按钮 h30 radius6） */
.navbar-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  height: 60rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background-color: var(--color-brand-primary);
  color: var(--color-text-on-brand);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.navbar-plus {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}
